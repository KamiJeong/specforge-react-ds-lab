{
  "name": "@specforge/react-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": {
      "types": "./dist/index.d.css.ts",
      "default": "./dist/index.css"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun scripts/copy-declaration-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package-contract": "bun run build && bun scripts/verify-package-contract.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "install:browser": "playwright install chromium",
    "test:storybook:browser": "bun run build-storybook && bun scripts/verify-storybook-browser.mjs",
    "verify": "bun run typecheck && bun run test && bun run build && bun run test:package-contract && bun run test:storybook:browser"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.2.12",
    "@storybook/addon-docs": "10.2.12",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "10.2.12",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "10.2.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
