{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specforge.dev/schemas/eval-case.schema.json",
  "title": "SpecForge Eval Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "requirements", "acceptance_criteria", "purpose", "category", "preconditions", "procedure", "oracle", "required_evidence", "blocking", "automation"],
  "properties": {
    "id": {"type": "string", "pattern": "^EVAL-(?:[0-9]+|LOCAL-[A-F0-9]{12})-[0-9]{3,}$"},
    "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-(?:[0-9]+|LOCAL-[A-F0-9]{12})-[0-9]{3,}$"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-(?:[0-9]+|LOCAL-[A-F0-9]{12})-[0-9]{3,}$"}},
    "purpose": {"type": "string", "minLength": 1},
    "category": {"enum": ["Static", "Unit", "Integration", "End-to-End", "API Contract", "Database", "Security", "Performance", "Accessibility", "Visual", "Backward Compatibility", "Migration Safety", "Observability"]},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "procedure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "command": {"type": ["string", "null"]},
    "oracle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blocking": {"type": "boolean"},
    "automation": {"enum": ["automated", "semi-automated", "manual"]}
  }
}
