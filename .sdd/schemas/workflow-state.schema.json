{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specforge.dev/schemas/workflow-state.schema.json",
  "title": "SpecForge Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue", "correlation_id", "slug", "branch", "current_stage", "completed_stages", "blocked_stage", "manual_decisions", "assumptions", "spec_status", "eval_design_status", "analysis_status", "implementation_status", "verification_status", "eval_status", "review_iteration", "open_findings", "convergence_status", "updated_at"],
  "$defs": {
    "stage": {"enum": ["intake", "spec", "clarify", "eval-design", "plan", "tasks", "analyze", "implement", "verify", "eval", "review", "fix", "converge", "ready-pr"]},
    "manualDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "options", "consequences", "blocking_stage", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "recommended_option": {"type": ["string", "null"]},
        "consequences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "blocking_stage": {"$ref": "#/$defs/stage"},
        "status": {"enum": ["open", "resolved"]},
        "decision": {"type": ["string", "null"]},
        "decided_by": {"type": ["string", "null"], "pattern": "^human:[A-Za-z0-9._-]+$"},
        "decided_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "issue": {"type": ["integer", "null"], "minimum": 1},
    "correlation_id": {"type": "string", "pattern": "^(?:[0-9]+|LOCAL-[A-F0-9]{12})$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "branch": {"type": ["string", "null"]},
    "current_stage": {"$ref": "#/$defs/stage"},
    "completed_stages": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stage"}},
    "blocked_stage": {"anyOf": [{"$ref": "#/$defs/stage"}, {"type": "null"}]},
    "manual_decisions": {"type": "array", "items": {"$ref": "#/$defs/manualDecision"}},
    "assumptions": {"type": "array", "items": {"$ref": "assumption.schema.json"}},
    "spec_status": {"enum": ["not_started", "draft", "approved"]},
    "eval_design_status": {"enum": ["not_started", "draft", "approved"]},
    "analysis_status": {"enum": ["not_started", "pass", "fail", "blocked"]},
    "implementation_status": {"enum": ["not_started", "in_progress", "complete", "blocked", "not_applicable"]},
    "verification_status": {"enum": ["not_started", "pass", "fail", "blocked", "not_applicable"]},
    "eval_status": {"enum": ["not_started", "pass", "fail", "blocked"]},
    "review_iteration": {"type": "integer", "minimum": 0, "maximum": 2},
    "open_findings": {"type": "array", "items": {"$ref": "review-finding.schema.json"}},
    "convergence_status": {"enum": ["not_started", "pass", "fail", "blocked"]},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"issue": {"type": "null"}}},
      "then": {"properties": {"correlation_id": {"pattern": "^LOCAL-[A-F0-9]{12}$"}}},
      "else": {"properties": {"correlation_id": {"pattern": "^[0-9]+$"}}}
    }
  ]
}
