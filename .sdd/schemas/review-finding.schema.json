{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specforge.dev/schemas/review-finding.schema.json",
  "title": "SpecForge Review Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "severity", "title", "description", "evidence", "status", "reported_by", "reported_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^FINDING-(?:[0-9]+|LOCAL-[A-F0-9]{12})-[0-9]{3,}$"},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "class": {"enum": ["BLOCKER", "MUST_FIX", "SHOULD_FIX", "OPTIONAL"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "affected_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-(?:[0-9]+|LOCAL-[A-F0-9]{12})-[0-9]{3,}$"}},
    "status": {"enum": ["open", "accepted", "resolved", "wont-fix"]},
    "resolution": {"type": ["string", "null"]},
    "reported_by": {"type": "string", "pattern": "^(specforge-reviewer/v[0-9]+|human:[A-Za-z0-9._-]+)$"},
    "reported_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"severity": {"const": "P0"}}}, "then": {"properties": {"class": {"const": "BLOCKER"}}, "required": ["class"]}},
    {"if": {"properties": {"severity": {"const": "P1"}}}, "then": {"properties": {"class": {"const": "MUST_FIX"}}, "required": ["class"]}},
    {"if": {"properties": {"severity": {"const": "P2"}}}, "then": {"properties": {"class": {"const": "SHOULD_FIX"}}, "required": ["class"]}},
    {"if": {"properties": {"severity": {"const": "P3"}}}, "then": {"properties": {"class": {"const": "OPTIONAL"}}, "required": ["class"]}}
  ]
}
